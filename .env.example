# Public build-time settings. VITE_ values are included in browser assets.
# Required backend partner ID. No preset registry or fallback identity.
# The temporary chain API currently has a fixture for global only.
VITE_PARTNER=global

# Required public deployment origin accepted by the backend (also used by the dev proxy).
VITE_APP_ORIGIN=https://perps.orbs.network

# Optional WalletConnect / mobile wallet pairing. Supply your own project ID.
# Without it, injected browser wallets remain available.
VITE_WALLETCONNECT_PROJECT_ID=
